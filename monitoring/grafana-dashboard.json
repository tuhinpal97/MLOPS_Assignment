{
  "title": "Heart Disease API - MLOps Assignment",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [
        {
          "expr": "sum(rate(heart_api_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "P95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(heart_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Prediction counts",
      "targets": [
        {
          "expr": "heart_predictions_total",
          "legendFormat": "class {{class}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    }
  ]
}